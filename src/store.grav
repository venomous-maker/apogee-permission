// store.grav — where roles and permissions are kept: by name, with users
// (any model) identified by a key such as "app.User#42"; in the app's
// database as Orbit models (and their migration), or in memory.
import "std"
import "grav-orbit"
use orbit.*

namespace apogee {

    interface AccessStore {
        fn createRole(name: string)
        fn createPermission(name: string)
        fn deleteRole(name: string)
        fn deletePermission(name: string)
        fn roles() -> Array<string>
        fn permissions() -> Array<string>
        fn grant(role: string, permission: string)
        fn revoke(role: string, permission: string)
        fn permissionsOfRole(role: string) -> Array<string>
        fn assign(model: string, role: string)
        fn unassign(model: string, role: string)
        fn rolesOf(model: string) -> Array<string>
        fn give(model: string, permission: string)
        fn take(model: string, permission: string)
        fn directPermissionsOf(model: string) -> Array<string>
        // The models that have `role`.
        fn modelsWithRole(role: string) -> Array<string>
    }

    // In this process's memory (development, tests). Thread-safe.
    class MemoryAccessStore implements AccessStore {
        private roleSet: HashSet<string> = new HashSet<string>()
        private permSet: HashSet<string> = new HashSet<string>()
        private rolePerms: HashMap<string, HashSet<string>> = new HashMap<string, HashSet<string>>()
        private modelRoles: HashMap<string, HashSet<string>> = new HashMap<string, HashSet<string>>()
        private modelPerms: HashMap<string, HashSet<string>> = new HashMap<string, HashSet<string>>()
        private lock: Mutex = new Mutex()
        constructor() {}
        private static fn add(m: HashMap<string, HashSet<string>>, k: string, v: string) {
            let s = m.getOr(k, null);
            if (s == null) { s = new HashSet<string>(); m.put(k, s); }
            s.add(v);
        }
        private static fn list(m: HashMap<string, HashSet<string>>, k: string) -> Array<string> {
            let s = m.getOr(k, null);
            let out = new Array<string>();
            if (s != null) { for (x in s) { out.push(x); } }
            out.sortBy(fn(a, b) => Str.compare(a, b));
            return out;
        }
        fn createRole(name: string) { self.lock.lock(); self.roleSet.add(name); self.lock.unlock(); }
        fn createPermission(name: string) { self.lock.lock(); self.permSet.add(name); self.lock.unlock(); }
        fn deleteRole(name: string) {
            self.lock.lock();
            self.roleSet.remove(name);
            self.rolePerms.remove(name);
            for (k in self.modelRoles.keys()) { self.modelRoles.get(k).remove(name); }
            self.lock.unlock();
        }
        fn deletePermission(name: string) {
            self.lock.lock();
            self.permSet.remove(name);
            for (k in self.rolePerms.keys()) { self.rolePerms.get(k).remove(name); }
            for (k in self.modelPerms.keys()) { self.modelPerms.get(k).remove(name); }
            self.lock.unlock();
        }
        fn roles() -> Array<string> { self.lock.lock(); let out = new Array<string>(); for (r in self.roleSet) { out.push(r); } self.lock.unlock(); out.sortBy(fn(a, b) => Str.compare(a, b)); return out; }
        fn permissions() -> Array<string> { self.lock.lock(); let out = new Array<string>(); for (p in self.permSet) { out.push(p); } self.lock.unlock(); out.sortBy(fn(a, b) => Str.compare(a, b)); return out; }
        fn grant(role: string, permission: string) { self.lock.lock(); MemoryAccessStore.add(self.rolePerms, role, permission); self.lock.unlock(); }
        fn revoke(role: string, permission: string) { self.lock.lock(); let s = self.rolePerms.getOr(role, null); if (s != null) { s.remove(permission); } self.lock.unlock(); }
        fn permissionsOfRole(role: string) -> Array<string> { self.lock.lock(); let out = MemoryAccessStore.list(self.rolePerms, role); self.lock.unlock(); return out; }
        fn assign(model: string, role: string) { self.lock.lock(); MemoryAccessStore.add(self.modelRoles, model, role); self.lock.unlock(); }
        fn unassign(model: string, role: string) { self.lock.lock(); let s = self.modelRoles.getOr(model, null); if (s != null) { s.remove(role); } self.lock.unlock(); }
        fn rolesOf(model: string) -> Array<string> { self.lock.lock(); let out = MemoryAccessStore.list(self.modelRoles, model); self.lock.unlock(); return out; }
        fn give(model: string, permission: string) { self.lock.lock(); MemoryAccessStore.add(self.modelPerms, model, permission); self.lock.unlock(); }
        fn take(model: string, permission: string) { self.lock.lock(); let s = self.modelPerms.getOr(model, null); if (s != null) { s.remove(permission); } self.lock.unlock(); }
        fn directPermissionsOf(model: string) -> Array<string> { self.lock.lock(); let out = MemoryAccessStore.list(self.modelPerms, model); self.lock.unlock(); return out; }
        fn modelsWithRole(role: string) -> Array<string> {
            let out = new Array<string>();
            self.lock.lock();
            for ((m, rs) in self.modelRoles) { if (rs.contains(role)) { out.push(m); } }
            self.lock.unlock();
            out.sortBy(fn(a, b) => Str.compare(a, b));
            return out;
        }
    }

    // The tables, as Orbit models (access_roles, access_permissions,
    // access_role_permissions, access_model_roles, access_model_permissions).
    class AccessRole extends Model { public id: long = 0  public name: string = ""  constructor() {} }
    class AccessPermission extends Model { public id: long = 0  public name: string = ""  constructor() {} }
    class AccessRolePermission extends Model { public id: long = 0  public role: string = ""  public permission: string = ""  constructor() {} }
    class AccessModelRole extends Model { public id: long = 0  public model: string = ""  public role: string = ""  constructor() {} }
    class AccessModelPermission extends Model { public id: long = 0  public model: string = ""  public permission: string = ""  constructor() {} }

    class CreateAccessTables extends Migration {
        constructor() {}
        fn up() {
            Schema.create("access_roles", fn(t: Blueprint) { t.id(); t.varchar("name", 125).unique(); });
            Schema.create("access_permissions", fn(t: Blueprint) { t.id(); t.varchar("name", 125).unique(); });
            Schema.create("access_role_permissions", fn(t: Blueprint) {
                t.id(); t.varchar("role", 125); t.varchar("permission", 125); t.unique(["role", "permission"]);
            });
            Schema.create("access_model_roles", fn(t: Blueprint) {
                t.id(); t.varchar("model", 190); t.varchar("role", 125); t.unique(["model", "role"]); t.index("role");
            });
            Schema.create("access_model_permissions", fn(t: Blueprint) {
                t.id(); t.varchar("model", 190); t.varchar("permission", 125); t.unique(["model", "permission"]);
            });
        }
        fn down() {
            for (t in ["access_model_permissions", "access_model_roles", "access_role_permissions", "access_permissions", "access_roles"]) { Schema.dropIfExists(t); }
        }
    }

    // In the app's database, through Orbit (see CreateAccessTables).
    class OrbitAccessStore implements AccessStore {
        constructor() {}
        private fn roles_() -> Query<AccessRole> { return new Query<AccessRole>(TableMap.of(reflect(AccessRole))); }
        private fn perms_() -> Query<AccessPermission> { return new Query<AccessPermission>(TableMap.of(reflect(AccessPermission))); }
        private fn rp() -> Query<AccessRolePermission> { return new Query<AccessRolePermission>(TableMap.of(reflect(AccessRolePermission))); }
        private fn mr() -> Query<AccessModelRole> { return new Query<AccessModelRole>(TableMap.of(reflect(AccessModelRole))); }
        private fn mp() -> Query<AccessModelPermission> { return new Query<AccessModelPermission>(TableMap.of(reflect(AccessModelPermission))); }
        fn createRole(name: string) {
            if (self.roles_().where("name", name).exists()) { return; }
            let r = new AccessRole(); r.name = name;
            try { r.save(); } catch (e: Exception) {}                    // (another process made it first)
        }
        fn createPermission(name: string) {
            if (self.perms_().where("name", name).exists()) { return; }
            let p = new AccessPermission(); p.name = name;
            try { p.save(); } catch (e: Exception) {}
        }
        fn deleteRole(name: string) {
            DB.transaction(fn() {
                self.rp().where("role", name).delete();
                self.mr().where("role", name).delete();
                self.roles_().where("name", name).delete();
            });
        }
        fn deletePermission(name: string) {
            DB.transaction(fn() {
                self.rp().where("permission", name).delete();
                self.mp().where("permission", name).delete();
                self.perms_().where("name", name).delete();
            });
        }
        fn roles() -> Array<string> { return self.roles_().orderBy("name").get().mapTo(fn(r: AccessRole) -> string => r.name); }
        fn permissions() -> Array<string> { return self.perms_().orderBy("name").get().mapTo(fn(p: AccessPermission) -> string => p.name); }
        fn grant(role: string, permission: string) {
            if (self.rp().where("role", role).where("permission", permission).exists()) { return; }
            let x = new AccessRolePermission(); x.role = role; x.permission = permission;
            try { x.save(); } catch (e: Exception) {}
        }
        fn revoke(role: string, permission: string) { self.rp().where("role", role).where("permission", permission).delete(); }
        fn permissionsOfRole(role: string) -> Array<string> {
            return self.rp().where("role", role).orderBy("permission").get().mapTo(fn(x: AccessRolePermission) -> string => x.permission);
        }
        fn assign(model: string, role: string) {
            if (self.mr().where("model", model).where("role", role).exists()) { return; }
            let x = new AccessModelRole(); x.model = model; x.role = role;
            try { x.save(); } catch (e: Exception) {}
        }
        fn unassign(model: string, role: string) { self.mr().where("model", model).where("role", role).delete(); }
        fn rolesOf(model: string) -> Array<string> { return self.mr().where("model", model).orderBy("role").get().mapTo(fn(x: AccessModelRole) -> string => x.role); }
        fn give(model: string, permission: string) {
            if (self.mp().where("model", model).where("permission", permission).exists()) { return; }
            let x = new AccessModelPermission(); x.model = model; x.permission = permission;
            try { x.save(); } catch (e: Exception) {}
        }
        fn take(model: string, permission: string) { self.mp().where("model", model).where("permission", permission).delete(); }
        fn directPermissionsOf(model: string) -> Array<string> {
            return self.mp().where("model", model).orderBy("permission").get().mapTo(fn(x: AccessModelPermission) -> string => x.permission);
        }
        fn modelsWithRole(role: string) -> Array<string> { return self.mr().where("role", role).orderBy("model").get().mapTo(fn(x: AccessModelRole) -> string => x.model); }
    }
}
